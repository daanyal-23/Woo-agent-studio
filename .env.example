# WooCommerce REST API Base URL
WOO_BASE_URL=http://localhost:8080/wp-json/wc/v3

# WooCommerce API Credentials (HTTP Basic Auth)
WOO_CONSUMER_KEY=ck_your_consumer_key_here
WOO_CONSUMER_SECRET=cs_your_consumer_secret_here

# Set to true ONLY for local development over HTTP.
# Production MUST be false or omitted (defaults to false).
WOO_ALLOW_INSECURE_HTTP=false

# Optional HTTP request timeout in seconds (default: 15.0)
WOO_TIMEOUT_SECONDS=15.0

# Optional flag to enable the live smoke test (default: 0)
# Set to 1 only when running: pytest -m live
WOO_LIVE_TEST=0

# ==================================================
# Store Seeding Configuration (WRITE ACCESS REQUIRED)
# ==================================================
# Dedicated write-capable credentials for seeding fictional data.
# The read-only WOO_CONSUMER_KEY/SECRET above must NOT be used for seeding.
WOO_SEED_CONSUMER_KEY=ck_your_write_capable_seed_key_here
WOO_SEED_CONSUMER_SECRET=cs_your_write_capable_seed_secret_here

# Explicit confirmation flag required before running the seed script (0=disabled, 1=enabled)
SEED_WOOCOMMERCE=0

# ==================================================
# Groq LLM Inference (Agent Demo & Evaluation)
# ==================================================
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
